# ============================================================================
# CreatorConnect AI — Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials as needed.
# The application includes a rich built-in persistent local database +
# deterministic AI engine fallback so it works out-of-the-box without external keys.
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret for Backend Session Verification
JWT_SECRET=replace_with_a_strong_random_secret_string_at_least_32_chars

# Supabase Configuration (Optional - Uses built-in persistent JSON/SQLite-compatible store if omitted)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AI Integration (Optional - Uses deterministic weighted scoring & structured brief generator fallback if omitted)
# Supports Gemini API or OpenAI-compatible API on the backend server only (never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gemini-2.5-flash
